{
  "manifest_version": 3,
  "name": "Open Page Capture",
  "version": "1.0.0",
  "description": "Full-page, visible-area and selected-area screenshots with a built-in editor, local history and on-device OCR PDFs. No account, no paywall, no cloud.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Page Capture",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms",
    "offscreen"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Capture the visible area"
    },
    "capture-full": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Capture the full page"
    },
    "capture-select": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture a selected area"
    },
    "open-history": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Open Your captures"
    }
  }
}